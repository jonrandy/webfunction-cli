# every method here calls straight through to the real dynamic client.
module WebFunctionClient
  class PersonAttributes
    def initialize: (untyped raw) -> void

    def name: () -> String
    def audit_ref: () -> String
  end

  class ListNotesResult
    def initialize: (untyped raw) -> void

    def text: () -> String
    def internal_flag: () -> bool
  end

  Undefined: untyped

  class Client
    def initialize: (untyped real_client) -> void
    def self.from_package_endpoint: (String url, ?bearer_auth: String?, ?version: String?, ?pipelined: bool) -> Client

    def internal_sync: (?sync_secret: String) -> bool
    def get_person: (id: String, ?debug_trace: bool, ?filter: Hash[Symbol, untyped]) -> PersonAttributes
    def list_notes: () -> Array[ListNotesResult]

    def call: (String endpoint_name, ?Hash[Symbol, untyped] args) -> untyped
    def package: () -> untyped
    def bearer_auth=: (String?) -> void
    def version=: (String?) -> void
    def pipeline=: (untyped) -> void
  end
end
