# Generated client for the Type Coverage Convert Test webfunction package.
# Source: https://example.test/package
#
# Wraps the real web_function gem (github.com/robinclart/web_function) -
# every method here calls straight through to the real dynamic client.
module WebFunctionClient
  class TypedPage[out Item]
    include Enumerable[Item]

    def initialize: (untyped real_page, Class? item_class) -> void
    def page: () -> Array[Item]
    def next?: () -> bool
    def previous?: () -> bool
    def next_page: () -> TypedPage[Item]?
    def previous_page: () -> TypedPage[Item]?
  end

  class AddressAttributes
    def initialize: (untyped raw) -> void

    def street: () -> String
    def city: () -> String
    def verified: () -> bool
  end

  class AccountAttributes
    def initialize: (untyped raw) -> void

    def id: () -> String
    def email: () -> String
    def age: () -> Integer
    def active: () -> bool
    def score: () -> (Integer | Float)
    def nickname: () -> (String | nil)
    def tags: () -> Array[String]
    def role: () -> ("admin" | "member" | "guest")
    def home: () -> AddressAttributes
    def previous_homes: () -> Array[AddressAttributes]
    def extra: () -> untyped
  end

  class NodeAttributes
    def initialize: (untyped raw) -> void

    def label: () -> String
    def children: () -> Array[NodeAttributes]
    def parent: () -> (NodeAttributes | nil)
  end

  Undefined: untyped

  class Client
    def initialize: (untyped real_client) -> void
    def self.from_package_endpoint: (String url, ?bearer_auth: String?, ?version: String?, ?pipelined: bool) -> Client

    def create_account: (email: String, ?id: String, ?homepage: String, ?feed: String, ?birthday: String, ?wake_time: String, ?last_login: String, ?phone: String, ?avatar: String, ?v4: String, ?v6: String, ?host: String, ?age: Integer, ?big: Integer, ?delta: Integer, ?huge_delta: Integer, ?ratio: Float, ?precise: Float, ?joined_at: Integer, ?score: Integer | Float, ?active: bool, ?anything: untyped, ?loose_list: Array[untyped], ?loose_object: Hash[Symbol, untyped], ?tags: Array[String], ?scores: Array[Integer | Float], ?nickname: String | nil, ?contact: String | Integer | Float, ?role: "admin" | "member" | "guest", ?level: 1 | 2 | 3, ?home: Hash[Symbol, untyped], ?previous_homes: Array[Hash[Symbol, untyped]]) -> AccountAttributes
    def list_accounts: (?limit: Integer) -> TypedPage[untyped]
    def get_stats: () -> (Integer | Float)
    def ping: () -> bool
    def get_tags: () -> Array[String]
    def find_account: (id: String) -> (AccountAttributes | nil)
    def get_tree: () -> NodeAttributes

    def call: (String endpoint_name, ?Hash[Symbol, untyped] args) -> untyped
    def package: () -> untyped
    def bearer_auth=: (String?) -> void
    def version=: (String?) -> void
    def pipeline=: (untyped) -> void
  end
end
