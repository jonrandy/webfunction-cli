{
  "openapi": "3.1.0",
  "info": {
    "title": "Array Choices Test",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.example.com"
    }
  ],
  "paths": {
    "/set-tags": {
      "post": {
        "operationId": "setTags",
        "summary": "set-tags",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "bad-tags": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": [
                        "red",
                        42,
                        "red"
                      ]
                    }
                  },
                  "tags": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": [
                        "red",
                        "green",
                        "blue"
                      ]
                    }
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      }
    }
  }
}